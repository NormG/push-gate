# .gate.conf — push-gate configuration for this project
# Copy to your project root, rename to .gate.conf, and edit.
#
# All paths are relative to the project root.
# {VERSION} is substituted with the version read from GATE_VERSION_SOURCE.
# ---------------------------------------------------------------------------

# ── Version source ──────────────────────────────────────────────────────────
# File that contains the canonical version number.
GATE_VERSION_SOURCE="Cargo.toml"

# Extended regex used to extract the version (first capture group is the value).
GATE_VERSION_REGEX='^version\s*=\s*"([0-9]+\.[0-9]+\.[0-9]+)"'

# ── Version sync targets ────────────────────────────────────────────────────
# Array of "file:match-regex:replacement" triples.
# match-regex:   ERE pattern that the line SHOULD match when in sync
#                (use {VERSION} as a placeholder for the actual version)
# replacement:   the exact string to substitute the matched line with
#                (use {VERSION} as a placeholder)
#
# If a line matching the regex is NOT found in the file, gate fix will
# replace the first line matching the base pattern (VERSION placeholder
# removed) with the replacement string.
# Delimiter between file, match, and replacement is '|' (not ':') so that
# colons in RPM field names (Version:) and TOML values are safe.
GATE_SYNC=(
    # RPM spec Version: field
    "home-backup.spec|^Version:[[:space:]]*{VERSION}[[:space:]]*$|Version:        {VERSION}"

    # package-rpm.sh VERSION= variable
    'package-rpm.sh|^VERSION="{VERSION}"|VERSION="{VERSION}"'

    # README.md — RPM filename in the installation section
    'README.md|home-backup-{VERSION}-1\.fc[0-9]|home-backup-{VERSION}-1.fc'
)

# ── Auto-fix commands ───────────────────────────────────────────────────────
# Commands that may modify files and whose changes are auto-committed.
# gate fix runs these and stages any resulting changes.
# gate check runs them with --check (or diffs before/after) to detect drift.
GATE_AUTO_FIX=(
    "cargo fmt"
)

# ── Must-pass checks ────────────────────────────────────────────────────────
# Commands that must exit 0 AND produce no output (stdout+stderr combined).
# Any output is treated as a warning/error and blocks the push.
GATE_MUST_PASS=(
    "cargo check --quiet"
    "cargo clippy --quiet"
)

# ── Output-tolerant checks (optional) ─────────────────────────────────────────
# By default, a GATE_MUST_PASS command must produce NO output. Some legitimate
# checks (e.g. a build that prints progress, or `npm run dist`) emit output even
# on success. List such commands here and they are judged purely by exit code
# (output is discarded). List the EXACT command string as it appears above.
# GATE_PASS_ON_EXIT_ONLY=(
#     "npm run dist"
# )
